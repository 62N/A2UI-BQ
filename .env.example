# Local development & deployment configuration
# Copy to `.env` and fill in your environment values.

# Google Cloud & Vertex AI configuration
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Optional: Gemini Enterprise & Cloud Run registration settings (used by sync_ge_metadata.py)
PROJECT_NUMBER=000000000000
GE_LOCATION=global
GE_ENGINE_ID=your-ge-engine-id
OAUTH_AUTH_ID=finops-google-oauth
APP_URL=https://your-cloud-run-service.run.app
A2UI_BQ_STEP_DELAY_SECONDS=1.5
